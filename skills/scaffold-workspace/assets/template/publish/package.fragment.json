{
  "scripts": {
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm docs:check && pnpm typecheck && pnpm circular && pnpm test && pnpm test:types && pnpm test:docs && pnpm build && pnpm check:dist && pnpm pack:check",
    "check:dist": "node scripts/bin.ts dist-types",
    "codegen": "effect-kit-codegen codegen --pattern \"packages/*/src/index.ts\"",
    "docs:check": "effect-kit-jsdocs --check",
    "pack:check": "node scripts/bin.ts pack-check",
    "release:check": "node scripts/bin.ts release check",
    "release:pack": "changeset pack --out-dir tmp/release",
    "release:smoke": "node scripts/bin.ts release smoke",
    "release:version": "changeset version && pnpm install --ignore-scripts --no-frozen-lockfile && dprint fmt",
    "test:docs": "vitest run --config vitest.docs.ts",
    "test:types": "tstyche"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect-kit/codegen": "0.1.0",
    "@effect-kit/jsdocs": "0.1.0",
    "@effect/doctest": "4.1.5",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "publint": "0.3.25",
    "tstyche": "7.2.5"
  }
}
