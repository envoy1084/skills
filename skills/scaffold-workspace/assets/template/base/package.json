{
  "name": "__NAME__",
  "version": "0.0.0",
  "private": true,
  "description": "__DESCRIPTION__",
  "license": "__LICENSE__",
  "type": "module",
  "scripts": {
    "build": "turbo --root-turbo-json .config/turbo.json run build",
    "check": "pnpm format:check && pnpm lint && turbo --root-turbo-json .config/turbo.json run typecheck build && pnpm test",
    "dev": "turbo --root-turbo-json .config/turbo.json run dev",
    "format": "oxfmt -c .config/oxfmt.config.ts --ignore-path .gitignore --ignore-path .config/oxfmtignore --write .",
    "format:check": "oxfmt -c .config/oxfmt.config.ts --ignore-path .gitignore --ignore-path .config/oxfmtignore --check .",
    "lint": "turbo --root-turbo-json .config/turbo.json run lint",
    "lint:fix": "turbo --root-turbo-json .config/turbo.json run lint -- --fix",
    "prepare": "lefthook install && effect-tsgo patch --typescript --oxlint",
    "test": "vitest run -c .config/vitest.config.ts",
    "typecheck": "turbo --root-turbo-json .config/turbo.json run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@interfere/landmines": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
