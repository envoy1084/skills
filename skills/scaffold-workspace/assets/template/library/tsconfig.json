{
  "extends": "__TSCONFIG_PRESET__",
  "compilerOptions": {
    "customConditions": ["workspace-source"],
    "rootDir": ".",
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        },
        "keyPatterns": [{ "target": "service", "pattern": "package-identifier" }],
        "allowedUnstableApis": ["@effect/vitest"]
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
